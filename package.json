{
  "name": "recursive-agentfold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Recursive AgentFold: proactive context folding + llm_query chunk scanning for mega-large contexts without losing the prompt cache.",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "bench": "pnpm --filter @raf/benchmarks run cli",
    "prompt-check": "pnpm --filter @raf/benchmarks run cli prompt-check"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "workspaces": ["packages/*"]
}
