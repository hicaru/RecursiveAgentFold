# Z.ai GLM Coding Plan (OpenAI-compatible endpoint)
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Root / branch AgentFold model (thinking model, usual AgentFold scheme)
RAF_ROOT_MODEL=glm-5.3
RAF_ROOT_CONTEXT=1000000
RAF_ROOT_MAX_OUTPUT=16000
# enabled | disabled | (empty = do not send the param; glm-5.3* cannot disable thinking,
# so it is configured through RAF_*_EXTRA_BODY exactly like rlm.pi / pi-ai does)
RAF_ROOT_THINKING=
# Extra JSON merged into the request body, e.g. {"reasoning_effort":"low"}
RAF_ROOT_TEMPERATURE=0
RAF_ROOT_EXTRA_BODY={"thinking":{"type":"enabled","clear_thinking":false}}

# llm_query model (non-thinking reader; big context, cheap)
RAF_QUERY_MODEL=glm-5.3-flash
RAF_QUERY_CONTEXT=1000000
RAF_QUERY_MAX_OUTPUT=4096
RAF_QUERY_THINKING=
RAF_QUERY_EXTRA_BODY={"thinking":{"type":"enabled","clear_thinking":false},"reasoning_effort":"low"}

# llm_query chunking: chunk = context * (1 - reserve), optionally capped
RAF_RESERVE_RATIO=0.3
RAF_MAX_CHUNK_TOKENS=
RAF_QUERY_CONCURRENCY=4

# Optional: HuggingFace token for dataset download
HF_TOKEN=
